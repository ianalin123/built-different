# Auth0 — provisioned via `stripe projects add auth0/client` then `stripe projects env --pull`
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: use a real Price from your Stripe sandbox; falls back to inline $10/mo price_data
STRIPE_PRICE_ID=
